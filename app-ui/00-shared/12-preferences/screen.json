{
  "title": "Language & appearance",
  "subtitle": "Choose readable settings for this device",
  "kind": "settings",
  "nav": "shared",
  "layout": "08-settings-admin",
  "body_layouts": {
    "mobile": "08-settings-admin",
    "tablet": "08-settings-admin",
    "desktop": "08-settings-admin"
  },
  "shells": {
    "mobile": "04-field-mobile-shell",
    "tablet": "05-field-tablet-shell",
    "desktop": "06-desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "empty",
    "error",
    "forbidden"
  ],
  "route": "/00-shared/12-preferences",
  "parent_route": "/00-shared/12-preferences",
  "roles": [
    "authenticated-user"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "shared",
  "l10n_key_prefix": "00_shared.12_preferences",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [
      {
        "label": "Workspaces",
        "to": "/00-shared/08-role-surface-picker"
      },
      {
        "label": "Notifications",
        "to": "/00-shared/09-notifications-center"
      },
      {
        "label": "Preferences",
        "to": "/00-shared/12-preferences"
      },
      {
        "label": "Sign out",
        "to": "/00-shared/03-login"
      }
    ],
    "primary_action": {
      "label": "Save preferences",
      "to": "/00-shared/12-preferences?state=success"
    },
    "access_denied": "/00-shared/10-access-denied",
    "not_found": "/00-shared/11-not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
