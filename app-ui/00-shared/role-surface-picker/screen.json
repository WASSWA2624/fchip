{
  "title": "Choose your workspace",
  "subtitle": "Consumers \u00b7 data feeders \u00b7 admin",
  "kind": "list",
  "nav": "auth",
  "layout": "list-worklist",
  "body_layouts": {
    "mobile": "list-worklist",
    "tablet": "list-worklist",
    "desktop": "dual-pane-desktop"
  },
  "shells": {
    "mobile": "auth-centered-card",
    "tablet": "auth-centered-card",
    "desktop": "auth-centered-card"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "empty",
    "error",
    "forbidden"
  ],
  "route": "/00-shared/role-surface-picker",
  "parent_route": "/00-shared/role-surface-picker",
  "roles": [
    "authenticated-user"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "shared",
  "l10n_key_prefix": "00_shared.role_surface_picker",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [],
    "primary_action": null,
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc",
