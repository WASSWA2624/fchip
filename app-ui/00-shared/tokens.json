  "accessibility": {
    "min_touch_target_px": 48,
    "min_text_px": 11,
    "contrast": "Primary teal on white for body actions; white on primary for CTAs",
    "focus": "Visible focus ring on every interactive row, field, tab, menu, and dialog action",
    "status": "Never rely on colour alone; pair colour with an icon and text",
    "text_scaling": "Controls remain visible at 200% text scaling",
    "offline": "PIN lock + queued forms; never require live network for draft capture"
  },
  "auth": {
    "register": ["phone_number", "password"],
    "sign_in": ["phone_number", "password"],
    "reset_password": ["phone_number", "new_password"],
    "not_required": ["email", "otp", "sms_code", "biometric", "social_login", "id_document"]
  },
  "source": ".cursor/app-write-up.mdc + app-flows/"
}
