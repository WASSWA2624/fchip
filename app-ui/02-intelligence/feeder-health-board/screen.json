{
  "title": "Feeder health board",
  "subtitle": "Which data parties are sending clean signals",
  "kind": "dashboard",
  "nav": "intel",
  "layout": "connector-status",
  "body_layouts": {
    "mobile": "connector-status",
    "tablet": "connector-status",
    "desktop": "dual-pane-desktop"
  },
  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "empty",
    "error",
    "forbidden"
  ],
  "route": "/02-intelligence/feeder-health-board",
  "parent_route": "/02-intelligence/ingest-pipeline",
  "roles": [
    "intelligence-analyst",
    "platform-operator"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "mvp",
  "l10n_key_prefix": "02_intelligence.feeder_health_board",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [
      {
        "label": "Ingest",
        "to": "/02-intelligence/ingest-pipeline"
      },
      {
        "label": "AI",
        "to": "/02-intelligence/ai-risk-scores"
      },
      {
        "label": "GIS",
        "to": "/02-intelligence/gis-explorer"
      },
      {
        "label": "Guidance",
        "to": "/02-intelligence/clinical-support-guidance"
      }
    ],
    "primary_action": {
      "label": "Open silent feeders",
      "to": "/02-intelligence/ingest-pipeline"
    },
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
