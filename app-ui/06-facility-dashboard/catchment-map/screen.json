{
  "title": "Catchment map",
  "subtitle": "Village hotspots + climate overlay",
  "kind": "map",
  "nav": "facility",
  "layout": "map-explorer",
  "body_layouts": {
    "mobile": "map-explorer",
    "tablet": "map-explorer",
    "desktop": "map-explorer"
  },
  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "empty",
    "error",
    "forbidden"
  ],
  "route": "/06-facility-dashboard/catchment-map",
  "parent_route": "/06-facility-dashboard/catchment-map",
  "roles": [
    "facility-clinician",
    "facility-manager"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "mvp",
  "l10n_key_prefix": "06_facility_dashboard.catchment_map",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [
      {
        "label": "Overview",
        "to": "/06-facility-dashboard/overview"
      },
      {
        "label": "Map",
        "to": "/06-facility-dashboard/catchment-map"
      },
      {
        "label": "Referrals",
        "to": "/07-referrals-desk/referral-queue"
      },
      {
        "label": "Stock",
        "to": "/06-facility-dashboard/stock-signal"
      }
    ],
    "primary_action": null,
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
