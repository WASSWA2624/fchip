{
  "title": "Clinical share confirm",
  "subtitle": "Facility staff approve what leaves EMR into FCHIP",
  "kind": "form",
  "nav": "facility",
  "layout": "form-capture",
  "body_layouts": {
    "mobile": "form-capture",
    "tablet": "form-capture",
    "desktop": "form-capture"
  },
  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "error",
    "success",
    "offline",
    "forbidden"
  ],
  "route": "/06-facility-dashboard/clinical-share-confirm",
  "parent_route": "/06-facility-dashboard/overview",
  "roles": [
    "facility-clinician",
    "facility-manager"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "mvp",
  "l10n_key_prefix": "06_facility_dashboard.clinical_share_confirm",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [
      {
        "label": "Overview",
        "to": "/06-facility-dashboard/overview"
      },
      {
        "label": "Map",
        "to": "/06-facility-dashboard/catchment-map"
      },
      {
        "label": "Referrals",
        "to": "/07-referrals-desk/referral-queue"
      },
      {
        "label": "Stock",
        "to": "/06-facility-dashboard/stock-signal"
      }
    ],
    "primary_action": {
      "label": "Push to FCHIP",
      "to": "/06-facility-dashboard/clinical-share-confirm?state=success"
    },
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
