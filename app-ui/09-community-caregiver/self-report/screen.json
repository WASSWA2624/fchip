{
  "title": "Self-report",
  "subtitle": "Symptoms \u00b7 needs \u00b7 concerns",
  "kind": "form",
  "nav": "caregiver",
  "layout": "form-capture",
  "body_layouts": {
    "mobile": "form-capture",
    "tablet": "form-capture",
    "desktop": "form-capture"
  },
  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "error",
    "success",
    "offline",
    "forbidden"
  ],
  "route": "/09-community-caregiver/self-report",
  "parent_route": "/09-community-caregiver/self-report",
  "roles": [
    "caregiver",
    "community-member"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "mvp",
  "l10n_key_prefix": "09_community_caregiver.self_report",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [
      {
        "label": "Home",
        "to": "/09-community-caregiver/my-household"
      },
      {
        "label": "Report",
        "to": "/09-community-caregiver/self-report"
      },
      {
        "label": "Guidance",
        "to": "/09-community-caregiver/guidance-hints"
      },
      {
        "label": "More",
        "to": "/09-community-caregiver/household-needs-capture"
      }
    ],
    "primary_action": {
      "label": "Send to CHW worklist",
      "to": "/09-community-caregiver/my-household?state=success"
    },
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
