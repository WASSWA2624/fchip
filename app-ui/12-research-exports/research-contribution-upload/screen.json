    "default",
    "loading",
    "error",
    "success",
    "offline",
    "forbidden"
  ],
  "route": "/12-research-exports/research-contribution-upload",
  "parent_route": "/12-research-exports/evidence-catalog",
  "roles": [
    "ngo-partner",
    "researcher"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
