{
  "title": "Research contribution upload",
  "subtitle": "Academic partners feed approved anonymised field sets",
  "kind": "form",
  "nav": "partner",
  "layout": "upload-batch",
  "body_layouts": {
    "mobile": "upload-batch",
    "tablet": "upload-batch",
    "desktop": "upload-batch"
  },
  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
