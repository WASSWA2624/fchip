      },
      {
        "label": "Evidence",
        "to": "/11-ngo-partner/impact-evidence"
      },
      {
        "label": "Training",
        "to": "/11-ngo-partner/training-skills-analytics"
      },
      {
        "label": "More",
        "to": "/12-research-exports/evidence-catalog"
      }
    ],
    "primary_action": {
      "label": "Contribute dataset",
      "to": "/12-research-exports/research-contribution-upload?state=success"
    },
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
