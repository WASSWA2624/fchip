        "label": "Home",
        "to": "/17-labs-poc/lab-home"
      },
      {
        "label": "Results",
        "to": "/17-labs-poc/result-entry"
      },
      {
        "label": "Queue",
        "to": "/17-labs-poc/result-queue"
      },
      {
        "label": "Sync",
        "to": "/17-labs-poc/batch-results-upload"
      }
    ],
    "primary_action": {
      "label": "Sync queue",
      "to": "/17-labs-poc/result-queue"
    },
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
