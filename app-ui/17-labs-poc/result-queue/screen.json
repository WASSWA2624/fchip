{
  "title": "Result queue",
  "subtitle": "Results waiting to sync or link to referrals",
  "kind": "queue",
  "nav": "lab",
  "layout": "queue-desk",
  "body_layouts": {
    "mobile": "queue-desk",
    "tablet": "queue-desk",
    "desktop": "dual-pane-desktop"
