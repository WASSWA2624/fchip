  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "empty",
    "error",
    "forbidden",
    "success",
    "conflict",
    "offline"
  ],
  "route": "/17-labs-poc/result-queue",
