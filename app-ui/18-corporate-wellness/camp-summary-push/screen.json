{
  "title": "Camp summary push",
  "subtitle": "Aggregate wellness signals to NCD intelligence",
  "kind": "form",
  "nav": "corporate",
  "layout": "form-capture",
  "body_layouts": {
    "mobile": "form-capture",
    "tablet": "form-capture",
    "desktop": "form-capture"
  },
  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "error",
    "success",
    "offline",
    "forbidden"
  ],
  "route": "/18-corporate-wellness/camp-summary-push",
  "parent_route": "/18-corporate-wellness/camp-summary-push",
  "roles": [
    "wellness-programme-worker"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "phase-2",
  "l10n_key_prefix": "18_corporate_wellness.camp_summary_push",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [
      {
        "label": "Home",
        "to": "/18-corporate-wellness/corporate-home"
      },
      {
        "label": "Vitals",
        "to": "/18-corporate-wellness/camp-vitals-entry"
      },
      {
        "label": "Summary",
        "to": "/18-corporate-wellness/camp-summary-push"
      },
      {
        "label": "Flags",
        "to": "/18-corporate-wellness/occupational-flags"
      }
    ],
    "primary_action": {
      "label": "Push summary to ingest",
      "to": "/18-corporate-wellness/camp-summary-push?state=success"
    },
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
