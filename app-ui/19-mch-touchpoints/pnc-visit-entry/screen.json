{
  "title": "PNC visit entry",
  "subtitle": "Postnatal follow-up signals",
  "kind": "form",
  "nav": "mch",
  "layout": "form-capture",
  "body_layouts": {
    "mobile": "form-capture",
    "tablet": "form-capture",
    "desktop": "form-capture"
  },
  "shells": {
    "mobile": "field-mobile-shell",
    "tablet": "field-tablet-shell",
    "desktop": "desktop-sidebar-shell"
  },
  "state": "default",
  "supported_states": [
    "default",
    "loading",
    "error",
    "success",
    "offline",
    "forbidden"
  ],
  "route": "/19-mch-touchpoints/pnc-visit-entry",
  "parent_route": "/19-mch-touchpoints/mch-home",
  "roles": [
    "mch-worker"
  ],
  "access": {
    "policy": "RBAC + ABAC + subscription + assigned modules",
    "unauthorised_behavior": "omit navigation and actions; deep links redirect to access-denied"
  },
  "phase": "phase-2",
  "l10n_key_prefix": "19_mch_touchpoints.pnc_visit_entry",
  "identifier_policy": "Display human_friendly_id only; never expose raw database IDs",
  "navigation": {
    "tabs": [
      {
        "label": "Home",
        "to": "/19-mch-touchpoints/mch-home"
      },
      {
        "label": "ANC",
        "to": "/19-mch-touchpoints/anc-visit-entry"
      },
      {
        "label": "Immunise",
        "to": "/19-mch-touchpoints/immunisation-entry"
      },
      {
        "label": "Nutrition",
        "to": "/19-mch-touchpoints/nutrition-monitoring"
      }
    ],
    "primary_action": {
      "label": "Save PNC visit",
      "to": "/19-mch-touchpoints/pnc-visit-entry?state=success"
    },
    "access_denied": "/00-shared/access-denied",
    "not_found": "/00-shared/not-found"
  },
  "source": "app-flows + .cursor/app-write-up.mdc"
}
